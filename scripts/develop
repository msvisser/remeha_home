#!/usr/bin/env bash

set -e

cd "$(dirname "$0")/.."

# Create config dir if not present
if [[ ! -d "${PWD}/config" ]]; then
    mkdir -p "${PWD}/config"
    python3 -m homeassistant --config "${PWD}/config" --script ensure_config
fi

# Set the path to custom_components
## This lets us keep the integration in <root>/custom_components/remeha_home
## and the Home Assistant configuration in <root>/config, without symlinks.
export PYTHONPATH="${PYTHONPATH}:${PWD}/custom_components"

# Start Home Assistant
python3 -m homeassistant --config "${PWD}/config" --debug
